# Isolation Forest
N_ESTIMATORS=300
CONTAMINATION=0.08
MAX_SAMPLES=auto
RANDOM_STATE=42

# Feature engineering
RATE_WINDOW_SECONDS=60
TRAIN_RATIO=0.7
VAL_RATIO=0.15

# PostgreSQL (docker-compose defaults)
DATABASE_URL=postgresql+psycopg2://postgres:secret@localhost:5432/qos_anomaly

# App
APP_ENV=dev
HISTORY_LIMIT=200
VIZ_SAMPLE_SIZE=5000

# FastAPI (optional)
API_HOST=0.0.0.0
API_PORT=8000
